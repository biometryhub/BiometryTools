rmsd_by_var <- sqrt(msd_by_var)

summary_tbl <- data.frame(
  Variety = names(op_by_var),
  OP      = as.numeric(op_by_var),
  MSD     = as.numeric(msd_by_var),
  RMSD    = as.numeric(rmsd_by_var),
  row.names = NULL
)

summary_tbl[order(-summary_tbl$OP), ]
