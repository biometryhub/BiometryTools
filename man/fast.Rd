m_fa <- asreml(
  fixed    = yield ~ Nitrogen,                 # Fixed treatment levels
  random   = ~ Block + Block:Variety + fa(Nitrogen, 2):Variety,
  residual = ~ units,
  data     = oats
)

out <- fast(m_fa, dat = oats, term = "fa(Nitrogen, 2):Variety")

